{
  "permissions": {
    "defaultMode": "acceptEdits",
    "blockReadsOutsideWorkingDirectories": true,
    "ask": ["Bash(git fetch *)", "Bash(git pull *)", "Bash(git push *)",
            "Bash(dangerouslyDisableSandbox:true)"],
    "deny": ["Edit(/.github/**)",
             "Read(~/.ssh/**)", "Edit(~/.ssh/**)",
             "Read(~/.claude/.credentials.json)",
             "Edit(~/dotfiles/**)",
             "Edit(~/.claude/settings.json)", "Edit(~/.claude/settings.local.json)",
             "Edit(~/.claude/keybindings.json)", "Edit(~/.claude/CLAUDE.md)",
             "Edit(~/.claude/statusline.sh)", "Edit(~/.claude/themes/**)",
             "Edit(~/.claude/skills/**)"]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["git fetch *", "git pull *", "git push *"],
    "filesystem": {
      "allowWrite": ["~/.bundle", "~/.cache/gem"]
    },
    "network": {
      "allowedDomains": ["github.com", "*.githubusercontent.com"]
    }
  }
}
